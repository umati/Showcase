                    "EnumDefinition": {
                        "Fields": [
                            {
                                "Value": "0",
                                "Description": {
                                    "Text": "This value indicates a continuous light.",
                                    "Locale": "en"
                                },
                                "Name": "Continuous"
                            },
                            {
                                "Value": "1",
                                "Description": {
                                    "Text": "This value indicates a blinking light (blinking in regular intervals with equally long on and off times).",
                                    "Locale": "en"
                                },
                                "Name": "Blinking"
                            },
                            {
                                "Value": "2",
                                "Description": {
                                    "Text": "This value indicates a flashing light (blinking in intervals with longer off times than on times, per interval multiple on times are possible).",
                                    "Locale": "en"
                                },
                                "Name": "Flashing"
                            },
                            {
                                "Value": "3",
                                "Description": {
                                    "Text": "The light is handled in a way not defined in this version of the specification.",
                                    "Locale": "en"
                                },
                                "Name": "Other"
                            }
                        ]
