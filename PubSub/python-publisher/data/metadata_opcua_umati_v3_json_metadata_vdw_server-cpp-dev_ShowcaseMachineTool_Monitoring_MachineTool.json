                    },
                    "Name": {
                        "Name": "MachineOperationMode",
                        "Uri": 5
                    },
                    "EnumDefinition": {
                        "Fields": [
                            {
                                "Value": "0",
                                "Description": {
                                    "Text": "The machine tool is controlled manually, by the operator. Depending on technology specific norms, the maximum axis movement speeds of the machine tool are limited.",
                                    "Locale": "en"
                                },
                                "Name": "Manual"
                            },
                            {
                                "Value": "1",
                                "Description": {
                                    "Text": "Operating mode for the automatic, programmed and continuous operation of the machine. Manual loading and unloading workpieces are possible when the automatic program is stopped. Axis movement speeds are fully available to the machine tool’s ability.",
                                    "Locale": "en"
                                },
                                "Name": "Automatic"
                            },
                            {
                                "Value": "2",
                                "Description": {
                                    "Text": "Depending on technology specific norms, the maximum axis movement speeds of the machine tool are limited. In this mode, the operator can make settings for the subsequent work processes.",
                                    "Locale": "en"
                                },
                                "Name": "Setup"
                            },
                            {
                                "Value": "3",
                                "Description": {
                                    "Text": "Operating mode with the possibility of manual interventions in the machining process as well as limited automatic operation started by the operator. Depending on technology specific norms, the maximum axis movement speeds of the machine tool are limited.",
                                    "Locale": "en"
                                },
                                "Name": "AutoWithManualIntervention"
                            },
                            {
                                "Value": "4",
                                "Description": {
                                    "Text": "Operating mode for service purposes. This mode shall not be used for manufacturing any parts. This mode shall only be used by authorized personnel.",
                                    "Locale": "en"
                                },
                                "Name": "Service"
                            },
                            {
                                "Value": "5",
                                "Description": {
                                    "Text": "The machine operation mode is different from the values defined in this enumeration.",
                                    "Locale": "en"
                                },
                                "Name": "Other"
                            }
                        ]
                    },
                    "BuiltInType": 0
                }
