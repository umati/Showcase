                            {
                                "Value": "0",
                                "Description": {
                                    "Text": "There is an active command being executed by the NC channel.",
                                    "Locale": "en"
                                },
                                "Name": "Active"
                            },
                            {
                                "Value": "1",
                                "Description": {
                                    "Text": "The NC execution is interrupted. Execution of a program in the channel can be restarted.",
                                    "Locale": "en"
                                },
                                "Name": "Interrupted"
                            },
                            {
                                "Value": "2",
                                "Description": {
                                    "Text": "No NC command is active in the NC channel. E.g. channel is idle.",
